# Compiled class file
*.class
*.project
*.iml
/.idea/
/target/

# Gradle
/build/
/.gradle/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...except the Gradle wrapper jar, which must be committed for ./gradlew to work
!gradle/wrapper/gradle-wrapper.jar

# Directly-added API (No maven repository for it)
bin/*
src/mkremins/*
src/net/*
.classpath
.settings

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/bin/
